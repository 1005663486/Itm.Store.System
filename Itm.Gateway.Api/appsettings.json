{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {

      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/bodega/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/inventory/{**catch-all}"
          }
        ]
      },

      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/ordenes/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/orders/{**catch-all}"
          }
        ]
      },

      "price-route": {
        "ClusterId": "price-cluster",
        "Match": {
          "Path": "/precios/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/prices/{**catch-all}"
          }
        ]
      },

      "search-route": {
        "ClusterId": "search-cluster",
        "Match": {
          "Path": "/buscar"
        },
        "Transforms": [
          {
            "PathPattern": "/api/search"
          }
        ]
      }

    },

    "Clusters": {

      "inventory-cluster": {
        "Destinations": {
          "inventory-api": {
            "Address": "http://localhost:5273/"
          }
        }
      },

      "order-cluster": {
        "Destinations": {
          "order-api": {
            "Address": "http://localhost:5110/"
          }
        }
      },

      "price-cluster": {
        "Destinations": {
          "price-api": {
            "Address": "http://localhost:5022/"
          }
        }
      },

      "search-cluster": {
        "Destinations": {
          "search-api": {
            "Address": "http://localhost:5062/"
          }
        }
      }

    }
  }
}