<?xml version="1.0" encoding="utf-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Itm.Store.Mobile.Pages"
    x:Class="Itm.Store.Mobile.AppShell">

    <Shell.Resources>
        <ResourceDictionary>
            <Color x:Key="NavBarColor">#0D0D1A</Color>
            <Color x:Key="TabBarColor">#0D0D1A</Color>
        </ResourceDictionary>
    </Shell.Resources>

    <TabBar>
        <ShellContent
            Title="Eventos"
            ContentTemplate="{DataTemplate pages:EventsPage}"
            Route="events"/>
    </TabBar>
</Shell>
